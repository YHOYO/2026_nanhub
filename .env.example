# === Server Configuration ===
PORT=8080
NODE_ENV=production

# === NaN API Configuration ===
NAN_BASE_URL=https://api.nan.builders/v1
NAN_API_KEY=sk-tu-key-aqui

# === Context Compression Phase ===
# Phase 0: passthrough (solo metricas)
# Phase 1: sliding window + resumen
# Phase 2: recuperacion semantica
# Phase 3: RAG sobre codebase
# Phase 4: hibrido (resumen + RAG domain)
# Phase 5: smart (estrategia dinamica)
PHASE=0

# === Database ===
DATABASE_PATH=/data/nanproxy.db

# === Admin Panel ===
ADMIN_EMAIL=admin@nanproxy.local
ADMIN_PASSWORD=cambiar-en-produccion
JWT_SECRET=generar-clave-secreta-aqui

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# === Logging ===
LOG_LEVEL=info
LOG_PATH=./logs

# === CORS ===
CORS_ORIGIN=*

# === Proxy Settings ===
PROXY_TIMEOUT=30000