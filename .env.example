# === Server Configuration ===
PORT=8080
NODE_ENV=production

# === NaN API Configuration ===
NAN_BASE_URL=https://api.nan.builders/v1
NAN_API_KEY=sk-tu-key-aqui

# === Database ===
DATABASE_PATH=/data/nanproxy.db

# === Admin Panel ===
ADMIN_EMAIL=admin@nanproxy.local
ADMIN_PASSWORD=cambiar-en-produccion
JWT_SECRET=generar-clave-secreta-aqui

# === Rate Limiting ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# === Logging ===
LOG_LEVEL=info
LOG_PATH=./logs

# === CORS ===
CORS_ORIGIN=*

# === Proxy Settings ===
PROXY_TIMEOUT=30000

# === NaN Cloud Image Generation ===
# API base URL for NaN Cloud (no cambiar a menos que sea necesario)
NAN_CLOUD_API_BASE=https://cloud-api.nan.builders
# Session cookie JWT (obtener desde DevTools después de login)
NAN_CLOUD_SESSION_COOKIE=
# Expiry date of the session cookie (formato ISO)
NAN_CLOUD_SESSION_EXPIRY=
# Email para solicitar magic link de login
NAN_CLOUD_EMAIL=yhoyodaqp@gmail.com